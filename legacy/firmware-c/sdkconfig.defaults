# RockRobot3 固件默认配置（首次全量生成 sdkconfig 时生效；改这里后需删除 sdkconfig 重新构建）

# ---- 蓝牙：经典蓝牙 SPP 控制台（控制器必须 BR/EDR-only，与宿主栈匹配；关 BLE 省内存）----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

# ---- 看门狗：超时在 main.c 里用 esp_task_wdt_reconfigure 运行时改 120s ----
# （此配置项合法范围 1~60 秒，写 120 会被静默丢弃回退 5s，勿在此调大）

# ---- 分区表：2MB flash 单大 app 分区（factory 1984KB）----
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- 内存瘦身：经典 ESP32 同时跑 WiFi + 蓝牙 + HTTPS(TLS) 很紧张 ----
# WiFi 缓冲区（默认 static 10/dynamic 32/tx 32 太奢侈）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
# TLS 单条记录缓冲 16KB→4KB（我们的请求/响应都很小，省 ~24KB 堆）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# TLS 1.3：DeepSeek 官方 API 走腾讯 EdgeOne CDN，设备 TLS1.2 握手被服务端 alert 拒绝，
# 必须像 curl 一样以 TLS1.3 协商
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
