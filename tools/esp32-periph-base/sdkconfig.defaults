# 批B 外设底座档（0.0.5 增补轮五）：main 线程只做 init+println（哨兵同款安全
# 画像——默认 3584B 装不下 println 缓冲），指令循环在自起 16KB 线程；两项与
# 哨兵 sdkconfig.defaults 同口径。
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 2026-10-31 SoftAP 配网面（用户口径：WiFi 会换，机器人必须能自己配网——ADR-0021
# 裁定 1 独立形态要求）。显式打开，不吃 IDF 缺省的运气：缺省值随 IDF 版本/目标变动，
# 而配网入口是"板子能否上线"的唯一通路。
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCPS=y
# 控制台回 UART0 缺省（USB 串口可观测 boot 横幅：凭据源 + SoftAP SSID 点名）。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# W4-2b 云 TTS（HTTPS）：mbedTLS 根证书束。契约禁止明文回退，证书校验必须在位；
# FULL 档覆盖主流 CA（Let's Encrypt/DigiCert/Google/Amazon 等），Flash 代价 ~64 KB。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# classic 板载 4MB Flash：spool 分区表要落到 0x400000，构建期必须按 4MB 校验
# （IDF 缺省 2MB 会直接拒表）。S3 档由 sdkconfig.defaults.esp32s3 后载覆盖为 16MB。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# W7-b1a 存储/流式承载（ADR-0031 裁定 1）：自定义分区表，追加 1MB spool 数据区，
# 语音段落 flash、RAM 只留工作台。表文件随 crate 维护，经 .cargo/config.toml 的
# ESP_IDF_GLOB 钩子搬进 IDF 构建 out/（PROJECT_DIR 不是 crate 根）；nvs/phy 偏移
# 保持 IDF 缺省，重烧 app 不动 WiFi 凭据。classic/S3 共用同一张表。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
